# -*- coding: utf-8 -*-
"""
مرحله‌ی ۳ — Similarity Search روی pgvector (روی سیستم خودتان اجرا می‌شود).

قبل از اجرا:
    pip install sentence-transformers psycopg2-binary pgvector

نکته: چون فقط یک متنِ کوتاه (query) امبد می‌شود نه میلیون‌ها ردیف، اجرا روی
CPU کاملاً سریع است — نیازی به GPU نیست.

⚠️ TODO مهم: اسم و ستون‌های جدول اصلی دیتاست خودتان (که کامنت‌ها/محصولات
واقعی‌تان توشه) را در پایین (COMMENTS_TABLE, PRODUCTS_TABLE و ستون‌ها) با
شِمای واقعی خودتان جایگزین کنید.
"""

import numpy as np
import psycopg2
from pgvector.psycopg2 import register_vector
from sentence_transformers import SentenceTransformer

# ================== تنظیمات ==================

POSTGRES_DSN = "dbname=YOUR_DB user=YOUR_USER password=YOUR_PASS host=localhost port=5432"

EMBEDDING_MODEL_NAME = "intfloat/multilingual-e5-base"   # باید دقیقاً همون مدلی باشه که در مرحله‌ی ۱ استفاده کردید
USE_E5_PREFIXES = True

# TODO: این‌ها را با شِمای واقعی دیتاست خودتان جایگزین کنید
COMMENTS_TABLE = "your_comments_table"
COMMENTS_ID_COL = "id"
COMMENTS_TEXT_COL = "body"          # ستونی که می‌خواهید در نتیجه نمایش داده شود

# ===============================================


print("Loading embedding model (CPU, فقط برای query - سریع است)...")
model = SentenceTransformer(EMBEDDING_MODEL_NAME, device="cpu")


def embed_query(text: str) -> np.ndarray:
    prefixed = f"query: {text}" if USE_E5_PREFIXES else text
    vec = model.encode([prefixed], convert_to_numpy=True, normalize_embeddings=True)[0]
    return vec.astype(np.float32)


def get_pg_conn():
    conn = psycopg2.connect(POSTGRES_DSN)
    register_vector(conn)
    return conn


def search_comments(query_text: str, top_k: int = 10):
    q_vec = embed_query(query_text)
    conn = get_pg_conn()
    sql = f"""
        SELECT c.{COMMENTS_ID_COL}, c.{COMMENTS_TEXT_COL}, e.embedding <=> %s AS distance
        FROM comments_embeddings e
        JOIN {COMMENTS_TABLE} c ON c.{COMMENTS_ID_COL}::varchar = e.id
        ORDER BY e.embedding <=> %s
        LIMIT %s;
    """
    with conn.cursor() as cur:
        cur.execute(sql, (q_vec, q_vec, top_k))
        results = cur.fetchall()
    conn.close()
    return results



if __name__ == "__main__":
    print("\n=== تست جستجوی کامنت‌ها ===")
    query = "کیفیت عطر و ماندگاری بوش خیلی خوب بود"
    for rid, text, dist in search_comments(query, top_k=5):
        print(f"dist={dist:.4f}  id={rid}  {str(text)[:100]!r}")

