"""
مرحله‌ی ۲ — بارگذاری embeddingهای صادرشده از Colab به Postgres محلی.

این اسکریپت را روی خود سیستم‌تان اجرا کنید (نه Colab). چون Postgres شما
لوکال است، این اتصال با host=localhost همیشه بدون مشکل کار می‌کند —
هیچ تانل یا تنظیم شبکه‌ای لازم نیست.

قبل از اجرا:
    pip install psycopg2-binary pgvector pandas pyarrow

نحوه‌ی اجرا:
    python 2_load_embeddings_to_postgres.py

فایل‌های ورودی مورد انتظار (خروجی نوت‌بوک اول، از Drive دانلود/سینک‌شده):
    <LOCAL_EXPORT_DIR>/comments/*.parquet   (ستون‌های id, embedding)
"""

import sys
from pathlib import Path

import numpy as np
import pandas as pd
import psycopg2
from psycopg2.extras import execute_values
from pgvector.psycopg2 import register_vector

# ================== تنظیمات — این‌ها را با مقادیر واقعی خودتان جایگزین کنید ==================

# مسیر محلی جایی که فایل‌های خروجی نوت‌بوک اول را گذاشته‌اید
# (بعد از دانلود از Drive، یا اگر Google Drive Desktop نصب دارید مستقیم به همان پوشه‌ی سینک‌شده)
LOCAL_EXPORT_DIR = Path(r"C:\Users\YOUR_USERNAME\Downloads\embeddings_export")

# اتصال Postgres محلی (همان user/password/dbname که در pgAdmin استفاده می‌کنید)
POSTGRES_DSN = "dbname=YOUR_DB user=YOUR_USER password=YOUR_PASS host=localhost port=5432"

# هر چند ردیف یک‌بار به دیتابیس نوشته شود (برای جلوگیری از فشار حافظه روی فایل‌های بزرگ)
CHUNK_SIZE = 5000

# ============================================================================================


def get_pg_conn():
    conn = psycopg2.connect(POSTGRES_DSN)
    with conn.cursor() as cur:
        cur.execute("CREATE EXTENSION IF NOT EXISTS vector;")
    conn.commit()
    register_vector(conn)
    return conn


def ensure_tables(conn, dim):
    with conn.cursor() as cur:
        cur.execute(f"""
        CREATE TABLE IF NOT EXISTS comments_embeddings (
            id VARCHAR(64) PRIMARY KEY,
            embedding VECTOR({dim})
        );
        """)
    conn.commit()


def create_ann_index(conn, table, column="embedding", metric_ops="vector_cosine_ops"):
    idx_name = f"{table}_{column}_ann_idx"
    with conn.cursor() as cur:
        try:
            cur.execute(f"""
                CREATE INDEX IF NOT EXISTS {idx_name}
                ON {table} USING hnsw ({column} {metric_ops})
                WITH (m = 16, ef_construction = 64);
            """)
            conn.commit()
            print(f"HNSW index created on {table}.{column}")
            return
        except Exception as e:
            conn.rollback()
            print(f"HNSW not available ({e}); falling back to IVFFlat...")

        cur.execute(f"SELECT COUNT(*) FROM {table};")
        n_rows = cur.fetchone()[0]
        lists = max(100, min(4000, n_rows // 1000)) if n_rows > 0 else 100
        cur.execute(f"""
            CREATE INDEX IF NOT EXISTS {idx_name}
            ON {table} USING ivfflat ({column} {metric_ops})
            WITH (lists = {lists});
        """)
        conn.commit()
        print(f"IVFFlat index created on {table}.{column} (lists={lists})")


def load_folder(conn, folder: Path, table: str):
    files = sorted(folder.glob("*.parquet"))
    print(f"\n[{table}] Found {len(files)} files in {folder}")

    upsert_sql = f"""
    INSERT INTO {table} (id, embedding)
    VALUES %s
    ON CONFLICT (id) DO UPDATE SET embedding = EXCLUDED.embedding;
    """

    total_rows = 0
    for file in files:
        df = pd.read_parquet(file)
        n = len(df)
        print(f"  loading {file.name} ({n} rows)...", end=" ", flush=True)

        for i in range(0, n, CHUNK_SIZE):
            chunk = df.iloc[i : i + CHUNK_SIZE]
            # فایل‌های خروجی float16 هستن (برای کوچیک‌تر شدن حجم روی Drive)؛
            # ستون vector معمولی pgvector از float4 استفاده می‌کنه، پس قبل از insert به float32 برمی‌گردونیم
            embeddings_f32 = [np.asarray(e, dtype=np.float32) for e in chunk["embedding"]]
            rows = list(zip(chunk["id"].astype(str), embeddings_f32))
            with conn.cursor() as cur:
                execute_values(cur, upsert_sql, rows)
            conn.commit()

        total_rows += n
        print("done")

    print(f"[{table}] Total rows loaded: {total_rows}")


def main():
    comments_dir = LOCAL_EXPORT_DIR / "comments"

    if not comments_dir.exists():
        print(f"⚠️ پوشه‌ی {LOCAL_EXPORT_DIR} پیدا نشد. مسیر LOCAL_EXPORT_DIR را در بالای فایل درست کنید.")
        sys.exit(1)

    conn = get_pg_conn()
    print("Postgres connected (local).")

    # بعد از دیدن اولین فایل، بعد بردار رو تشخیص می‌دیم
    sample_file = next(comments_dir.glob("*.parquet"), None)
    if sample_file is None:
        print("⚠️ هیچ فایل parquet‌ای پیدا نشد.")
        sys.exit(1)

    sample_df = pd.read_parquet(sample_file)
    dim = len(sample_df["embedding"].iloc[0])
    print(f"Detected embedding dimension: {dim}")

    ensure_tables(conn, dim)

    if comments_dir.exists():
        load_folder(conn, comments_dir, "comments_embeddings")

    print("\nBuilding ANN indexes (may take a while for large tables)...")
    if comments_dir.exists():
        create_ann_index(conn, "comments_embeddings")

    conn.close()
    print("\n✅ همه‌چیز تموم شد. حالا می‌تونید با id به جدول اصلی دیتاست خودتون JOIN بزنید:")
    print("""
    SELECT c.*, e.embedding
    FROM your_comments_table c
    JOIN comments_embeddings e ON e.id = c.id::varchar;
    """)


if __name__ == "__main__":
    main()
