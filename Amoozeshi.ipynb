    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "sen1 = \"I am Meow\"\n",
    "sen2 = \"She is Wow\"\n",
    "sen3 = \"But He is Hop Hop\"\n",
    "\n",
    "vectors = embedding_model.encode([sen1, sen2, sen3])\n",
    "\n",
    "similarity_1_2 = cosine_similarity([vectors[0]], [vectors[1]])[0][0]\n",
    "\n",
    "similarity_1_3 = cosine_similarity([vectors[0]], [vectors[2]])[0][0]\n",
    "\n",
    "similarity_2_3 = cosine_similarity([vectors[1]], [vectors[2]])[0][0]\n",
    "\n",
    "print(f\"'{sen1}' & '{sen2}': {similarity_1_2:.4f}\")\n",
    "print(f\"'{sen1}' & '{sen3}': {similarity_1_3:.4f}\")\n",
    "print(f\"'{sen2}' & '{sen3}': {similarity_2_3:.4f}\")\n"
   ]
